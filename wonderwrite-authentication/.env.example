DATABASE_URL=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
JWT_ISSUER=wonderwrite

OTP_TTL=PT5M
OTP_RESEND_GAP=PT1M
OTP_MAX_ATTEMPTS=3
OTP_CODE_LENGTH=6

LOGIN_MAX_FAILED_PER_EMAIL=5
LOGIN_EMAIL_LOCKOUT=PT15M
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_IP_RATE_WINDOW=PT1M

OAUTH_SUCCESS_URL=/
OAUTH_FAILURE_URL=/login?error=oauth

OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
